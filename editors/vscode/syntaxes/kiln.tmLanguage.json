					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.kiln"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.kiln"
						}
					},
					"patterns": [
						{
							"include": "#escape"
						}
					]
				}
			]
		},
		"escape": {
			"match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|.)",
