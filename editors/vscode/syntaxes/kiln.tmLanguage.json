					"name": "keyword.operator.assignment.kiln"
				},
				{
					"match": "[?:]",
					"name": "keyword.operator.ternary.kiln"
				},
				{
					"match": ",",
					"name": "punctuation.separator.comma.kiln"
				},
				{
					"match": "\\b([a-zA-Z_]\\w*)\\s*(?=\\()",
					"captures": {
						"1": {
							"name": "entity.name.function.kiln"
						}
					}
				},
				{
					"match": "\\b(?:loop|slots)\\b",
					"name": "variable.language.kiln"
				},
				{
					"match": "\\b[a-zA-Z_]\\w*\\b",
					"name": "variable.other.readwrite.kiln"
				}
			]
		},
		"string": {
			"patterns": [
				{
					"name": "string.quoted.double.kiln",
					"begin": "\"",
					"end": "\"",
					"beginCaptures": {
