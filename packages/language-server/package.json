		"vscode-languageserver-textdocument": "1.0.15"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"typescript": "^7.0.2",
		"typescript-6": "npm:typescript@^6.0.3",
		"vite-plus": "1.2.0"
	},
	"volta": {
		"node": "24.22.0"
	},
	"engines": {
		"node": "^24.0.0"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
