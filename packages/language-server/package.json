{
	"name": "@lucidkiln/language-server",
	"version": "1.2.0",
	"description": "Language server for Kiln templates: errors as you type, formatting, completions, hover and go to definition.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/kiln.git",
		"directory": "packages/language-server"
	},
	"type": "module",
