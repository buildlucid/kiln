{% props site, current %}
<header class="site-header">
	<a class="logo" href="/">{{ site.name }}</a>
	<nav>
		<ul>
			{% for item in site.nav %}
			<li><a href="{{ item.url }}"{% if item.url == current %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
			{% endfor %}
		</ul>
	</nav>
</header>
