<main class="search">
	<form action="/search" role="search">
		<input type="search" name="q" value="{{ query }}">
	</form>
	<h1>{{ total|number_format }} results for “{{ query }}”</h1>
	<p>Showing {{ results|length }}</p>
	<ol class="results">
		{% for result in results %}
		<li class="result result--{{ result.category|lower }}">
			<p class="category">{{ result.category|upper }}</p>
			<h2><a href="{{ result.url }}?q={{ query|url_encode }}">{{ result.title }}</a></h2>
			<p>{{ result.excerpt|truncate(160) }}</p>
			<p class="meta">By {{ result.author.name ?? "Anonymous" }} · {{ result.tags|sort|join(", ") }}</p>
		</li>
		{% endfor %}
	</ol>
	<nav class="pagination">
		{% for number in 1..5 %}
		<a href="/search?q={{ query|url_encode }}&amp;page={{ number }}"{% if number == 1 %} aria-current="page"{% endif %}>{{ number }}</a>
		{% endfor %}
	</nav>
</main>
