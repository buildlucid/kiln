{# A product summary. Call it with {% call %}: the call body is the card's button, rendered by caller(). #}
{% macro productCard(product) %}
<article class="card">
	<a href="{{ product.url }}">
		<img src="{{ product.image.src }}" alt="{{ product.image.alt }}" loading="lazy">
		<h2>{{ product.name }}</h2>
	</a>
	{% if product.badges | length > 0 %}
	<ul class="badges">
		{% for badge in product.badges %}
		<li>{{ badge }}</li>
		{% endfor %}
	</ul>
	{% endif %}
	<p class="price">
		{% if product.salePrice %}
		<del>{{ product.price | formatPrice }}</del>
		<ins>{{ product.salePrice | formatPrice }}</ins>
		{% else %}
		{{ product.price | formatPrice }}
		{% endif %}
	</p>
	<p class="rating" aria-label="{{ product.rating }} out of 5">
		{% for star in range(1, 6) %}<span class="star{% if star <= product.rating %} star--filled{% endif %}">★</span>{% endfor %}
		<span>({{ product.reviewCount }})</span>
	</p>
	{% if not product.inStock %}
	<p class="stock">Out of stock</p>
	{% endif %}
	<div class="actions">{{ caller() }}</div>
</article>
{% endmacro %}
