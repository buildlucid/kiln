<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<title>{% block title %}{{ site.name }}{% endblock %}</title>
	<link rel="stylesheet" href="/styles.css">
</head>
<body>
	{% include "partials/header" with { site, current } %}
	<main>
		{% block content %}{% endblock %}
	</main>
	{% include "partials/footer" with { site } %}
</body>
</html>
