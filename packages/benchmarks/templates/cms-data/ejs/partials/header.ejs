<header class="site-header">
	<a class="logo" href="/"><%= site.name %></a>
	<nav>
		<ul>
			<% for (const item of await navigation("header")) { %>
			<li><a href="<%= item.url %>"<% if (item.url === current) { %> aria-current="page"<% } %>><%= item.title %></a></li>
			<% } %>
		</ul>
	</nav>
</header>
