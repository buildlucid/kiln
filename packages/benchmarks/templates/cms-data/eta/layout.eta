<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<title><%~ block("title", () => { %><%= it.site.name %><% }) %></title>
	<link rel="stylesheet" href="/styles.css">
</head>
<body>
	<% const [header, footer] = await Promise.all([includeAsync("@partials/header", { site: it.site, current: it.current }), includeAsync("@partials/footer", { site: it.site })]) %>
	<%~ header %>
	<main>
		<%~ it.body %>
	</main>
	<%~ footer %>
</body>
</html>
