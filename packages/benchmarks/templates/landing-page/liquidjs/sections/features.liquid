<section class="features">
	<h2>{{ section.heading }}</h2>
	<ul class="grid">
		{% for item in section.items %}
		<li>
			<svg class="icon" aria-hidden="true"><use href="#icon-{{ item.icon }}"></use></svg>
			<h3>{{ item.title }}</h3>
			<p>{{ item.text }}</p>
		</li>
		{% endfor %}
	</ul>
</section>
