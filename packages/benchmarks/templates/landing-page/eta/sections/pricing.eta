<section class="pricing">
	<h2><%= it.section.heading %></h2>
	<div class="plans">
		<% it.section.plans.forEach((plan) => { %>
		<div class="plan<% if (plan.featured) { %> plan--featured<% } %>">
			<h3><%= plan.name %></h3>
			<p class="price">
				<% if (plan.price === 0) { %>
				Free
				<% } else { %>
				<%= formatPrice(plan.price) %><span>/month</span>
				<% } %>
			</p>
			<ul>
				<% plan.features.forEach((feature) => { %>
				<li><%= feature %></li>
				<% }) %>
			</ul>
		</div>
		<% }) %>
	</div>
</section>
