<section class="hero">
	<div>
		<h1>{{ section.heading }}</h1>
		<p>{{ section.text }}</p>
		<div class="actions">
			{% for action in section.actions %}
			<a class="button {{ action.primary ? "button--primary" : "button--secondary" }}" href="{{ action.url }}">{{ action.label }}</a>
			{% endfor %}
		</div>
	</div>
	<img src="{{ section.image.src }}" alt="{{ section.image.alt }}">
</section>
