<section class="pricing">
	<h2><%= section.heading %></h2>
	<div class="plans">
		<% for (const plan of section.plans) { %>
		<div class="plan<% if (plan.featured) { %> plan--featured<% } %>">
			<h3><%= plan.name %></h3>
			<p class="price">
				<% if (plan.price === 0) { %>
				Free
				<% } else { %>
				<%= formatPrice(plan.price) %><span>/month</span>
				<% } %>
			</p>
			<ul>
				<% for (const feature of plan.features) { %>
				<li><%= feature %></li>
				<% } %>
			</ul>
		</div>
		<% } %>
	</div>
</section>
