<table class="users">
	<thead>
		<tr>
			{% for column in columns %}
			<th scope="col">{{ column }}</th>
			{% endfor %}
		</tr>
	</thead>
	<tbody>
		{% for row in rows %}
		<tr class="{{ loop.index is odd ? "odd" : "even" }}">
			<td>{{ row.id }}</td>
			<td>{{ row.name }}</td>
			<td><a href="mailto:{{ row.email }}">{{ row.email }}</a></td>
			<td>{{ row.role }}</td>
			<td><span class="status status--{{ row.active ? "active" : "inactive" }}">{{ row.active ? "Active" : "Inactive" }}</span></td>
			<td>{{ row.score }}</td>
		</tr>
		{% endfor %}
	</tbody>
</table>
