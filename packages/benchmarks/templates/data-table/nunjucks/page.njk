<table class="users">
	<thead>
		<tr>
			{% for column in columns %}
			<th scope="col">{{ column }}</th>
			{% endfor %}
		</tr>
	</thead>
	<tbody>
		{% for row in rows %}
		<tr class="{{ "odd" if loop.index is odd else "even" }}">
			<td>{{ row.id }}</td>
			<td>{{ row.name }}</td>
			<td><a href="mailto:{{ row.email }}">{{ row.email }}</a></td>
			<td>{{ row.role }}</td>
			<td><span class="status status--{{ "active" if row.active else "inactive" }}">{{ "Active" if row.active else "Inactive" }}</span></td>
			<td>{{ row.score }}</td>
		</tr>
		{% endfor %}
	</tbody>
</table>
