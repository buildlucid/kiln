{
	"compilerOptions": {
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"target": "ESNext",
		"lib": ["ESNext"],
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src", "vite.config.ts"]
}
