{
	"name": "kiln",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"bench": "vp run @lucidkiln/benchmarks#bench",
		"test": "vp test run",
		"test:watch": "vp test watch",
		"format": "vp fmt --check",
		"format:fix": "vp fmt",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"check": "vp check",
		"check:fix": "vp check --fix"
	},
	"devDependencies": {
		"vite-plus": "1.2.0"
	},
	"packageManager": "npm@12.2.0",
	"workspaces": [
		"packages/*",
		"apps/*",
		"editors/vscode"
	],
	"volta": {
		"node": "24.22.0"
	},
	"engines": {
		"node": "^24.0.0"
	},
	"license": "MIT",
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
	},
	"allowScripts": {
		"tree-sitter-cli@0.27.1": true,
		"workerd@1.20261012.1": true,
		"esbuild@0.28.2": true,
		"@vscode/vsce-sign@2.1.0": true
	}
}
