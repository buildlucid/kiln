{# Marks for the comparison tables on the comparison page and the landing page. #}

{# The icon for a cell: "yes", "no" or "partly". #}
{% macro icon(kind, isKiln = false) %}
	{% if kind == "yes" %}
		<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" class="mx-auto block shrink-0 {{ isKiln ? "text-ember" : "text-fg" }}"><circle cx="8" cy="8" r="7" fill="currentColor" opacity=".16"/><path d="m5 8.25 2 2 4-4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
	{% elseif kind == "no" %}
		<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" class="mx-auto block shrink-0 text-muted/50"><path d="M5.5 8h5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
	{% else %}
		<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" class="mx-auto block shrink-0 text-muted"><circle cx="8" cy="8" r="7" fill="currentColor" opacity=".16"/><path d="M8 4.5a3.5 3.5 0 0 1 0 7Z" fill="currentColor"/></svg>
	{% endif %}
{% endmacro %}

{#
	One table cell. A partial cell shows its note in a tooltip on hover or focus. The note stays
	in the page, so screen readers and the Markdown copy get "Partly" and the note.
	The last column's tooltip lines up with the right edge, so it doesn't overflow the table.
#}
{% macro mark(value, isKiln = false, isLast = false) %}
	{% if value == true %}
		{{ icon("yes", isKiln) }}<span class="sr-only">Yes</span>
	{% elseif value == false %}
		{{ icon("no") }}<span class="sr-only">No</span>
	{% else %}
		<span class="group relative inline-block rounded-full align-middle" tabindex="0">
			{{ icon("partly") }}
			<span class="pointer-events-none absolute bottom-full z-20 mb-2 w-max max-w-40 rounded-md border border-line-strong bg-raised px-2.5 py-1.5 text-left text-xs leading-snug text-fg opacity-0 shadow-lg transition-opacity group-hover:opacity-100 group-focus:opacity-100 {{ isLast ? "right-0" : "left-1/2 -translate-x-1/2" }}"><span class="sr-only">Partly: </span>{{ value }}</span>
		</span>
	{% endif %}
{% endmacro %}

{# The key to the marks, shown above a table. #}
{% macro legend() %}
	<ul class="flex list-none flex-wrap gap-x-5 gap-y-1 pl-0 text-sm text-muted">
		<li class="flex items-center gap-1.5 pl-0">{{ icon("yes") }} Has it</li>
		<li class="flex items-center gap-1.5 pl-0">{{ icon("partly") }} Partly. Hover for details</li>
		<li class="flex items-center gap-1.5 pl-0">{{ icon("no") }} Doesn't have it</li>
	</ul>
{% endmacro %}
