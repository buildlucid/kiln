{% extends "layouts/base" %}

{% from "macros/comparison" import mark, legend %}

{% block title %}{{ site.name }} · {{ site.tagline }}{% endblock %}

{% set features = [
	{
		title: "Familiar syntax",
		text: "If you have used Twig, Jinja or Liquid, you can read Kiln already. Names are camelCase, like JavaScript.",
		icon: "M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16",
	},
	{
		title: "Async data",
		text: "Templates call async functions to load what they need. Kiln only waits where a call returns a promise, and runs calls that don't depend on each other at the same time.",
		icon: "M12 3v4M12 17v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M3 12h4M17 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8",
	},
	{
		title: "Runs anywhere",
		text: "No eval, no Node built-ins and no dependencies in the core. Kiln runs on Node and Cloudflare Workers.",
		icon: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM3.6 9h16.8M3.6 15h16.8M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18",
	},
	{
		title: "Safe by default",
		text: "Templates only read what you give them, and output is escaped. Limits stop runaway templates.",
		icon: "M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3ZM9 12l2 2 4-4",
	},
	{
		title: "Layouts and components",
		text: "Share layouts with blocks. Build components with typed props and slots. Keep small snippets in macros.",
		icon: "M4 4h7v7H4zM13 4h7v4h-7zM13 10h7v10h-7zM4 13h7v7H4z",
	},
	{
		title: "Errors that help",
		text: "Every error names the template, line and column, shows the code around it and suggests a fix.",
		icon: "M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z",
	},
] %}

{# The hero's template, and the product the browser below it shows. #}
{% set heroTemplate %}
	{% verbatim %}
{% set product = document("product", slug) %}

<h1>{{ product.name }}</h1>
<p>{{ product.price|formatNumber(style: "currency", currency: "GBP") }}</p>

{% island "components/stock" with { id: product.id } %}
	<p>Checking stock…</p>
{% endisland %}
	{% endverbatim %}
{% endset %}
{% set product = { name: "Stoneware mug", price: 18, stock: 12 } %}

{# Benchmarks: every page a real site renders, without the cold start, which measures compiling. #}
{% set pageScenarios = benchmarks.scenarios|filter(scenario => not scenario.cold) %}
{# The CMS data page mostly measures time spent waiting for data, so it would hide how fast each engine renders. #}
{% set speedScenarios = pageScenarios|filter(scenario => scenario.id != "cms-data") %}
{% set rivals = ["nunjucks", "liquidjs", "twing"] %}

{% block main %}
	<main id="content" class="overflow-hidden">
		<section class="relative isolate">
			<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(40%_45%_at_75%_35%,color-mix(in_oklab,var(--color-ember)_14%,transparent),transparent),radial-gradient(35%_40%_at_15%_0%,color-mix(in_oklab,var(--color-ember)_8%,transparent),transparent)]"></div>
			<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(var(--color-line-strong)_1px,transparent_1px)] bg-[size:22px_22px] opacity-50 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_30%,black,transparent)]"></div>

			<div class="mx-auto grid max-w-[76rem] grid-cols-[minmax(0,1fr)] items-center gap-16 px-4 pt-16 pb-24 sm:px-6 sm:pt-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-14 lg:pt-24 lg:pb-32">
				<div class="text-center lg:text-left">
					<h1 class="mx-auto max-w-[17ch] text-[2.75rem] leading-[1.04] font-semibold tracking-[-0.04em] text-balance text-fg sm:text-[3.75rem] lg:mx-0 xl:text-[4rem]">
						Fast, safe templates for <span class="bg-gradient-to-br from-ember-soft via-ember to-[#e2582b] bg-clip-text text-transparent">server-rendered</span> websites.
					</h1>
					<p class="enter mx-auto mt-6 max-w-[34rem] text-lg leading-relaxed text-pretty text-muted lg:mx-0" style="--enter: 2">
						{{ site.name }} is a template language with syntax you already know. Templates load their own data, output is escaped by default, and it runs on Node and Cloudflare Workers.
					</p>
					<div class="enter mt-9 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start" style="--enter: 3">
						<a href="/docs/quick-start/" class="group inline-flex items-center gap-2 rounded-full bg-fg px-6 py-3 text-sm font-medium text-bg transition-[opacity,transform] hover:opacity-90 active:scale-[0.98]">
							Get started
							<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</a>
						<div class="flex items-center gap-1 rounded-full border border-line bg-surface/80 py-1.5 pr-1.5 pl-5 font-mono text-[13px] text-text">
							<span><span class="text-muted select-none">$ </span>npm install {{ site.package }}</span>
							{% include "components/copy" with { label: "Copy install command", text: "npm install " ~ site.package } %}
						</div>
					</div>
					<ul class="enter mt-9 flex flex-wrap justify-center gap-x-6 gap-y-2 text-[13px] text-muted lg:justify-start" style="--enter: 4">
						{% for point in ["Zero dependencies", "Strict by default", "MIT licensed"] %}
							<li class="flex items-center gap-1.5">
								<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" class="text-ember"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
								{{ point }}
							</li>
						{% endfor %}
					</ul>
				</div>

				<div class="mx-auto w-full max-w-[36rem] lg:max-w-none">
					<div class="hero-window enter" style="--enter: 2">
						{{ heroTemplate|highlight("kiln", title: "pages/product.kiln") }}
					</div>
					{#
						Between the template and the browser, the mascot eats packets of template and sends
						the page down. The line up from the island is the island loading from the server.
					#}
					<div class="hero-flow enter" style="--enter: 3" aria-hidden="true">
						{% for colour in ["var(--code-tag)", "var(--code-string)", "var(--code-keyword)"] %}
							<span class="hero-packet" style="--packet: {{ loop.index0 }}; background: {{ colour }}"></span>
						{% endfor %}
						<span class="hero-mascot">{% include "components/logo" with { size: 56, animated: true, mouth: true } %}</span>
						<span class="hero-spark"></span>
						<span class="hero-return">
							<svg viewBox="0 0 88 74" width="88" height="74"><path d="M84 74V14Q84 2 72 2H0" fill="none" stroke="currentColor" stroke-dasharray="3 3"/></svg>
							<span class="hero-return-dot"></span>
						</span>
					</div>
					{#
						The page in a browser. The name and price are static HTML. The stock is an island,
						which shows its fallback, then loads. Screen readers get the description instead.
					#}
					<figure class="hero-window enter" style="--enter: 4" role="img" aria-label="The rendered page in a browser. The name and price are static HTML. The stock level is an island, which shows its fallback until it loads.">
						<div class="code-head" aria-hidden="true"><span class="code-label">shop.example/mugs/stoneware</span></div>
						<div class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-5 p-5 sm:grid-cols-[7rem_minmax(0,1fr)]" aria-hidden="true">
							<div class="grid aspect-square place-items-center rounded-xl border border-line bg-raised bg-[radial-gradient(70%_70%_at_30%_25%,color-mix(in_oklab,var(--color-ember)_30%,transparent),transparent)] text-ember-soft">
								<svg viewBox="0 0 24 24" width="40%" height="40%"><path d="M5 7h11v8a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4V7ZM16 9h1.5a2.5 2.5 0 0 1 0 5H16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
							</div>
							<div class="min-w-0">
								<p class="text-lg font-semibold tracking-tight text-fg">{{ product.name }}</p>
								<p class="mt-0.5 text-sm text-muted tabular-nums">{{ product.price|formatNumber(style: "currency", currency: "GBP") }}</p>
								<div class="hero-island mt-4">
									<span class="hero-island-tag">island</span>
									<p class="hero-island-fallback">Checking stock…</p>
									<p class="hero-island-live"><span class="size-1.5 rounded-full bg-[#7fd6a0]"></span>{{ product.stock }} in stock</p>
								</div>
							</div>
						</div>
						<ul class="flex flex-wrap gap-x-5 gap-y-1.5 border-t border-line px-5 py-3 text-[12px] text-muted" aria-hidden="true">
							<li class="flex items-center gap-2"><span class="size-2.5 rounded-sm border border-line-strong bg-raised"></span>Static HTML, built once</li>
							<li class="flex items-center gap-2"><span class="size-2.5 rounded-sm border border-dashed border-ember"></span>Island, loaded on each visit</li>
						</ul>
					</figure>
				</div>
			</div>
		</section>

		<section aria-labelledby="example-title" class="reveal mx-auto max-w-[72rem] px-4 pt-12 sm:px-6">
			<div class="mx-auto max-w-[40rem] text-center">
				<p class="text-sm font-medium text-ember">How it works</p>
				<h2 id="example-title" class="mt-3 text-3xl font-semibold tracking-tight text-balance text-fg sm:text-4xl">Write a template. Get clean HTML.</h2>
				<p class="mt-4 leading-relaxed text-muted">Components take props and slots, loops know where they are, and data loads where it is used. Every example on this site is rendered by Kiln when the site builds.</p>
			</div>
			<div class="landing-example mt-12 rounded-2xl border border-line bg-surface/60 p-1.5 shadow-[0_0_80px_-20px_color-mix(in_oklab,var(--color-ember)_25%,transparent)]">
				{% set card %}
					{% verbatim %}
{% props title, href, date = null %}
<article class="card">
	<h2><a href="{{ href }}">{{ title }}</a></h2>
	{% if date %}
		<time>{{ date|formatDate(dateStyle: "long") }}</time>
	{% endif %}
	{% slot %}{% endslot %}
</article>
					{% endverbatim %}
				{% endset %}
				{% apply example(templates: { "components/card.kiln": card }) %}
					{% verbatim %}
{% set posts = documents("post", limit: 2) %}

{% for post in posts %}
	{% component "components/card" with {
		title: post.title,
		href: post.url,
		date: post.publishedAt,
	} %}
		<p>Post {{ loop.index }} of {{ loop.length }}</p>
	{% endcomponent %}
{% endfor %}
					{% endverbatim %}
				{% endapply %}
			</div>
		</section>

		<section aria-labelledby="features-title" class="mx-auto max-w-[72rem] px-4 py-28 sm:px-6">
			<div class="reveal max-w-[36rem]">
				<p class="text-sm font-medium text-ember">Why Kiln</p>
				<h2 id="features-title" class="mt-3 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">Everything a website needs. Nothing it doesn't.</h2>
			</div>
			<ul class="reveal mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
				{% for feature in features %}
					<li class="group bg-bg p-7 transition-colors duration-300 hover:bg-surface">
						<span class="grid size-10 place-items-center rounded-lg border border-line bg-surface text-ember transition-[border-color,box-shadow] duration-300 group-hover:border-ember/40 group-hover:shadow-[0_0_24px_-6px_var(--color-ember)]">
							<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="{{ feature.icon }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</span>
						<h3 class="mt-5 font-medium text-fg">{{ feature.title }}</h3>
						<p class="mt-2 text-[15px] leading-relaxed text-muted">{{ feature.text }}</p>
					</li>
				{% endfor %}
			</ul>
		</section>

		<section aria-labelledby="compare-title" class="mx-auto max-w-[72rem] px-4 pb-28 sm:px-6">
			<div class="reveal flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
				<div class="max-w-[38rem]">
					<p class="text-sm font-medium text-ember">Compared</p>
					<h2 id="compare-title" class="mt-3 text-3xl font-semibold tracking-tight text-balance text-fg sm:text-4xl">Built in, not bolted on.</h2>
					<p class="mt-4 leading-relaxed text-muted">Async data, islands, streaming and typed props come with {{ site.name }}. Here is how it compares with Twig and the most popular JavaScript template languages.</p>
				</div>
				{{ legend() }}
			</div>
			<div class="reveal mt-10 overflow-x-auto rounded-2xl border border-line bg-bg">
				<table class="w-full min-w-[36rem] table-fixed border-collapse text-[15px]">
					<colgroup>
						<col class="w-44 sm:w-[34%]">
						{% for engine in comparison.engines %}<col{{ attrs({ class: loop.first ? "bg-ember/[0.06]" }) }}>{% endfor %}
					</colgroup>
					<thead>
						<tr>
							<th scope="col" class="sticky left-0 z-10 bg-bg px-5 py-4 text-left font-medium text-fg">Feature</th>
							{% for engine in comparison.engines %}
								<th scope="col" class="px-2 py-4 text-center text-[13px] font-medium {{ loop.first ? "text-ember" : "text-muted" }}">{{ engine }}</th>
							{% endfor %}
						</tr>
					</thead>
					<tbody>
						{% for row in comparison.featured %}
							<tr class="border-t border-line">
								<th scope="row" class="sticky left-0 z-10 bg-bg px-5 py-3.5 text-left font-normal"><a href="{{ row.link }}" class="text-text underline decoration-transparent underline-offset-4 transition-colors hover:text-fg hover:decoration-line-strong">{{ row.feature }}</a></th>
								{% for cell in row.cells %}
									<td class="px-2 py-3.5 text-center">{{ mark(cell, loop.first, loop.last) }}</td>
								{% endfor %}
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
			<a href="/docs/comparison/" class="reveal mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-fg underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-fg">See the full comparison</a>
		</section>

		<section aria-labelledby="speed-title" class="border-y border-line bg-surface/50">
			<div class="mx-auto grid max-w-[72rem] grid-cols-[minmax(0,1fr)] gap-12 px-4 py-24 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] lg:gap-16">
				<div class="reveal">
					<p class="text-sm font-medium text-ember">Performance</p>
					<h2 id="speed-title" class="mt-3 text-3xl font-semibold tracking-tight text-balance text-fg sm:text-4xl">Fast where it counts.</h2>
					<p class="mt-4 leading-relaxed text-muted">We render the same {{ pageScenarios|length }} real pages with {{ benchmarks.engines|length }} JavaScript template engines, and check every engine's HTML matches before timing. {{ site.name }} precompiles templates at build time, so it stays fast on Cloudflare Workers too.</p>
					<dl class="mt-8 grid grid-cols-3 gap-px overflow-hidden rounded-xl border border-line bg-line">
						{% for id in rivals %}
							{% set engine = benchmarks.engines|find(item => item.id == id) %}
							{% set ratios = speedScenarios|map(scenario => (scenario.results|find(result => result.engine == id)).meanMs / (scenario.results|find(result => result.engine == "kiln")).meanMs) %}
							{% set speedup = (ratios|reduce((product, ratio) => product * ratio, 1)) ** (1 / ratios|length) %}
							<div class="flex flex-col-reverse justify-end bg-bg px-4 py-4">
								<dt class="mt-1 text-[13px] leading-snug text-muted">faster than {{ engine.name }}</dt>
								<dd class="text-2xl font-semibold tracking-tight text-fg tabular-nums">{{ speedup|formatNumber(maximumFractionDigits: speedup < 10 ? 1 : 0) }}×</dd>
							</div>
						{% endfor %}
					</dl>
					<p class="mt-3 text-[13px] leading-relaxed text-muted">Geometric mean across the pages, leaving out CMS data, which mostly measures waiting for data. {{ benchmarks.environment.cpu }}, Node {{ benchmarks.environment.node }}.</p>
					<a href="/docs/benchmarks/" class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-fg underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-fg">See every result and how we measure</a>
				</div>

				<div class="reveal min-w-0" data-tabs>
					<div role="tablist" aria-label="Benchmark pages" class="tab-scroll js-only flex gap-1 overflow-x-auto">
						{% for scenario in pageScenarios %}
							<button type="button" role="tab" id="tab-{{ scenario.id }}" aria-controls="panel-{{ scenario.id }}" aria-selected="{{ loop.first ? "true" : "false" }}" tabindex="{{ loop.first ? 0 : -1 }}" class="shrink-0 rounded-full border border-transparent px-3 py-1.5 text-[13px] whitespace-nowrap text-muted transition-colors hover:text-fg aria-selected:border-line aria-selected:bg-raised aria-selected:text-fg">{{ scenario.name }}</button>
						{% endfor %}
					</div>
					{% for scenario in pageScenarios %}
						{% set fastest = max(scenario.results|filter(result => result.supported)|map(result => result.opsPerSecond)) %}
						<div role="tabpanel" id="panel-{{ scenario.id }}" aria-labelledby="tab-{{ scenario.id }}" class="mt-5 rounded-2xl border border-line bg-bg p-5 sm:p-6"{{ attrs({ hidden: not loop.first }) }}>
							<p class="mb-3 flex justify-between text-[12px] text-muted"><span>Engine</span><span>Renders per second, higher is better</span></p>
							<ul class="space-y-2.5">
								{% for result in scenario.results %}
									{% set engine = benchmarks.engines|find(item => item.id == result.engine) %}
									{% set isKiln = engine.id == "kiln" %}
									<li class="grid grid-cols-[5.5rem_1fr] items-center gap-3 text-[13px] sm:grid-cols-[6.5rem_1fr]">
										<span class="{{ isKiln ? "font-medium text-fg" : "text-muted" }}">{{ engine.name }}</span>
										{% if result.supported %}
											<span class="flex items-center gap-3">
												<span class="h-2 flex-1 rounded-full bg-raised" aria-hidden="true">
													<span class="bar block h-2 min-w-1 rounded-full {{ isKiln ? "bg-gradient-to-r from-ember to-ember-soft" : "bg-muted/45" }}" style="width: {{ (result.opsPerSecond / fastest * 100)|round(1) }}%; --bar: {{ loop.index0 }}"></span>
												</span>
												<span class="w-16 text-right tabular-nums {{ isKiln ? "text-fg" : "text-muted" }}">{{ result.opsPerSecond|formatNumber(notation: "compact", maximumFractionDigits: 1) }}</span>
											</span>
										{% else %}
											<span class="text-muted">Can't wait for async data</span>
										{% endif %}
									</li>
								{% endfor %}
							</ul>
							<p class="mt-5 border-t border-line pt-4 text-sm leading-relaxed text-muted">{{ scenario.description }}</p>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>

		<section aria-labelledby="errors-title" class="mx-auto grid max-w-[72rem] grid-cols-[minmax(0,1fr)] items-center gap-12 px-4 py-28 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]">
			<div class="reveal">
				<p class="text-sm font-medium text-ember">Errors</p>
				<h2 id="errors-title" class="mt-3 text-3xl font-semibold tracking-tight text-fg">Mistakes point straight at the problem.</h2>
				<p class="mt-4 leading-relaxed text-muted">Strict mode is on by default, so a typo is an error instead of a blank space on the page. Errors show where they happened and suggest what you meant.</p>
				<a href="/docs/language/strict-mode/" class="mt-6 inline-block text-sm font-medium text-fg underline decoration-line-strong underline-offset-4 hover:decoration-fg">Read about strict mode</a>
			</div>
			<div class="reveal">
				{% apply highlight("text") %}
					{% verbatim %}
KilnRenderError: Unknown variable "titel" in pages/page.kiln
at line 4, column 9. Did you mean "title"?

  3 | {% block content %}
> 4 |   <h1>{{ titel }}</h1>
    |          ^^^^^
  5 | {% endblock %}
					{% endverbatim %}
				{% endapply %}
			</div>
		</section>

		<section aria-labelledby="start-title" class="relative isolate overflow-hidden border-t border-line">
			<div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[28rem] bg-[radial-gradient(45%_70%_at_50%_100%,color-mix(in_oklab,var(--color-ember)_20%,transparent),transparent)]"></div>
			<div class="reveal mx-auto flex max-w-[72rem] flex-col items-center px-4 pt-24 pb-28 text-center sm:px-6">
				<div class="relative">
					<div aria-hidden="true" class="absolute inset-x-[-40%] bottom-[-10%] h-1/2 rounded-full bg-ember/25 blur-2xl"></div>
					<div class="relative transition-transform duration-500 hover:-translate-y-1 hover:-rotate-3">
						{% include "components/logo" with { size: 104, animated: true } %}
					</div>
				</div>
				<h2 id="start-title" class="mt-10 text-3xl font-semibold tracking-tight text-fg sm:text-5xl">Fire up your first page.</h2>
				<p class="mx-auto mt-4 max-w-[30rem] leading-relaxed text-muted">Install {{ site.name }} and render a page with a layout in a few minutes.</p>
				<div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
					<a href="/docs/quick-start/" class="rounded-full bg-fg px-6 py-3 text-sm font-medium text-bg transition-[opacity,transform] hover:opacity-90 active:scale-[0.98]">Quick start</a>
					<a href="/docs/" class="rounded-full border border-line-strong bg-bg/60 px-6 py-3 text-sm font-medium text-fg transition-colors hover:border-muted hover:bg-surface">Read the docs</a>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
