{% extends "layouts/base" %}

{% block title %}{{ site.name }} · Fast, safe templates for server-rendered websites{% endblock %}

{% set features = [
	{
		title: "Familiar syntax",
		text: "If you have used Twig, Jinja or Liquid, you can read Kiln already. Names are camelCase, like JavaScript.",
		icon: "M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16",
	},
	{
		title: "Async data",
		text: "Templates call async functions to load what they need. Kiln only waits where a call returns a promise.",
		icon: "M12 3v4M12 17v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M3 12h4M17 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8",
	},
	{
		title: "Runs anywhere",
		text: "No eval, no Node built-ins and no dependencies in the core. Kiln runs on Node and Cloudflare Workers.",
		icon: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM3.6 9h16.8M3.6 15h16.8M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18",
	},
	{
		title: "Safe by default",
		text: "Templates only read what you give them, and output is escaped. Limits stop runaway templates.",
		icon: "M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3ZM9 12l2 2 4-4",
	},
	{
		title: "Layouts and components",
		text: "Share layouts with blocks. Build components with typed props and slots. Keep small snippets in macros.",
		icon: "M4 4h7v7H4zM13 4h7v4h-7zM13 10h7v10h-7zM4 13h7v7H4z",
	},
	{
		title: "Errors that help",
		text: "Every error names the template, line and column, shows the code around it and suggests a fix.",
		icon: "M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z",
	},
] %}

{% block main %}
<main id="content" class="overflow-hidden">
	<section class="relative">
		<div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-40 h-[36rem] bg-[radial-gradient(50%_50%_at_50%_40%,color-mix(in_oklab,var(--color-ember)_16%,transparent),transparent)]"></div>
		<div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-line)_1px,transparent_1px)] bg-[size:4rem_4rem] opacity-40 [mask-image:radial-gradient(ellipse_at_top,black,transparent_70%)]"></div>

		<div class="relative mx-auto max-w-[72rem] px-4 pt-24 pb-20 text-center sm:px-6 sm:pt-32">
			<div class="mb-8 flex justify-center">{% include "components/logo" with { size: 72 } %}</div>
			<h1 class="mx-auto max-w-[15ch] text-[2.75rem] leading-[1.05] font-semibold tracking-[-0.035em] text-fg sm:text-[4.25rem]">
				Templates for the server, done right.
			</h1>
			<p class="mx-auto mt-6 max-w-[38rem] text-lg leading-relaxed text-muted sm:text-xl">
				Kiln is a fast, safe template language for building websites. The syntax feels familiar, templates can load their own data, and it runs on Node and Cloudflare Workers.
			</p>
			<div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a href="/docs/quick-start/" class="rounded-full bg-fg px-6 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-90">Get started</a>
				<code class="rounded-full border border-line bg-surface px-5 py-3 font-mono text-[13px] text-text select-all"><span class="text-muted select-none">$ </span>npm install {{ site.package }}</code>
			</div>
		</div>
	</section>

	<section aria-label="Example" class="relative mx-auto max-w-[72rem] px-4 sm:px-6">
		<div class="landing-example rounded-2xl border border-line bg-surface/60 p-1.5 shadow-[0_0_80px_-20px_color-mix(in_oklab,var(--color-ember)_25%,transparent)]">
{% set card %}
{% verbatim %}
{% props title, href, date = null %}
<article class="card">
	<h2><a href="{{ href }}">{{ title }}</a></h2>
	{% if date %}
	<time>{{ date|formatDate(dateStyle: "long") }}</time>
	{% endif %}
	{% slot %}{% endslot %}
</article>
{% endverbatim %}
{% endset %}
{% apply example(templates: { "components/card.kiln": card }) %}
{% verbatim %}
{% set posts = documents("post", limit: 2) %}

{% for post in posts %}
	{% component "components/card" with {
		title: post.title,
		href: post.url,
		date: post.publishedAt,
	} %}
		<p>Post {{ loop.index }} of {{ loop.length }}</p>
	{% endcomponent %}
{% endfor %}
{% endverbatim %}
{% endapply %}
		</div>
	</section>

	<section aria-labelledby="features-title" class="mx-auto max-w-[72rem] px-4 py-28 sm:px-6">
		<div class="max-w-[36rem]">
			<p class="text-sm font-medium text-ember">Why Kiln</p>
			<h2 id="features-title" class="mt-3 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">Everything a website needs. Nothing it doesn't.</h2>
		</div>
		<ul class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
			{% for feature in features %}
			<li class="bg-bg p-7">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" class="text-ember"><path d="{{ feature.icon }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
				<h3 class="mt-5 font-medium text-fg">{{ feature.title }}</h3>
				<p class="mt-2 text-[15px] leading-relaxed text-muted">{{ feature.text }}</p>
			</li>
			{% endfor %}
		</ul>
	</section>

	<section aria-labelledby="errors-title" class="border-y border-line bg-surface/50">
		<div class="mx-auto grid max-w-[72rem] items-center gap-12 px-4 py-24 sm:px-6 lg:grid-cols-[1fr_1.3fr]">
			<div>
				<p class="text-sm font-medium text-ember">Errors</p>
				<h2 id="errors-title" class="mt-3 text-3xl font-semibold tracking-tight text-fg">Mistakes point straight at the problem.</h2>
				<p class="mt-4 leading-relaxed text-muted">Strict mode is on by default, so a typo is an error instead of a blank space on the page. Errors show where they happened and suggest what you meant.</p>
				<a href="/docs/language/strict-mode/" class="mt-6 inline-block text-sm font-medium text-fg underline decoration-line-strong underline-offset-4 hover:decoration-fg">Read about strict mode</a>
			</div>
{% apply highlight("text") %}
{% verbatim %}
KilnRenderError: Unknown variable "titel" in pages/page.kiln
at line 4, column 9. Did you mean "title"?

  3 | {% block content %}
> 4 |   <h1>{{ titel }}</h1>
    |          ^^^^^
  5 | {% endblock %}
{% endverbatim %}
{% endapply %}
		</div>
	</section>

	<section class="mx-auto max-w-[72rem] px-4 py-28 text-center sm:px-6">
		<h2 class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">Start building.</h2>
		<p class="mx-auto mt-4 max-w-[30rem] leading-relaxed text-muted">Install Kiln and render your first page in a few minutes.</p>
		<div class="mt-8 flex justify-center gap-3">
			<a href="/docs/quick-start/" class="rounded-full bg-fg px-6 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-90">Quick start</a>
			<a href="/docs/" class="rounded-full border border-line px-6 py-3 text-sm font-medium text-fg transition-colors hover:border-line-strong hover:bg-surface">Read the docs</a>
		</div>
	</section>
</main>
{% endblock %}
