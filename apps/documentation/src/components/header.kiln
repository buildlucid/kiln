{% props current %}

{% set inDocs = current starts with "/docs/" %}
{% set links = [
	{ title: "Docs", url: "/docs/", active: inDocs and not (current starts with "/docs/api/") and current != "/docs/benchmarks/" },
	{ title: "API", url: "/docs/api/create-kiln/", active: current starts with "/docs/api/" },
	{ title: "Benchmarks", url: "/docs/benchmarks/", active: current == "/docs/benchmarks/" },
] %}

<header class="site-header sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md backdrop-saturate-150">
	<div class="mx-auto flex h-14 max-w-[88rem] items-center gap-3 px-4 sm:gap-6 sm:px-6">
		<a href="/" class="group flex shrink-0 items-center gap-2.5 text-fg" aria-label="{{ site.name }} home">
			<span class="transition-transform duration-300 group-hover:-rotate-6">{% include "components/logo" %}</span>
			<span class="text-[15px] font-semibold tracking-tight">{{ site.name }}</span>
		</a>

		<button type="button" class="search-trigger js-only ml-auto flex h-9 items-center gap-2.5 rounded-lg border border-line bg-surface/80 px-2.5 text-sm text-muted transition-colors hover:border-line-strong hover:text-fg md:ml-4 md:w-60 md:px-3 lg:w-72" data-search-open aria-haspopup="dialog" aria-controls="search">
			<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" class="shrink-0"><circle cx="7" cy="7" r="4.75" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m10.5 10.5 3.25 3.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
			<span class="sr-only md:not-sr-only">Search docs</span>
			<kbd class="ml-auto hidden rounded border border-line bg-raised px-1.5 font-sans text-[11px] leading-5 text-muted md:inline" data-shortcut>Ctrl K</kbd>
		</button>

		<nav aria-label="Main" class="flex items-center gap-0.5 text-sm md:ml-auto">
			{% for link in links %}
				<a href="{{ link.url }}" class="nav-link rounded-md px-3 py-1.5 transition-colors hover:text-fg {{ link.active ? "text-fg" : "text-muted" }} {{ loop.first ? "" : "hidden sm:block" }}"{{ attrs({ "aria-current": link.active ? "page" }) }}>{{ link.title }}</a>
			{% endfor %}
			<a href="{{ site.repository }}" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-muted transition-colors hover:text-fg" aria-label="{{ site.name }} on GitHub">
				<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
			</a>
		</nav>
	</div>
</header>

{% include "components/search" %}
