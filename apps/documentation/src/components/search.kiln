{# The search dialog. client/search.ts loads Pagefind's index when it first opens. #}
<dialog id="search" class="search-dialog" aria-label="Search the docs">
	<div class="search-panel">
		<div class="flex items-center gap-3 border-b border-line px-4">
			<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" class="shrink-0 text-muted"><circle cx="7" cy="7" r="4.75" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m10.5 10.5 3.25 3.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
			<input type="search" class="h-14 min-w-0 flex-1 bg-transparent text-[15px] text-fg placeholder:text-muted focus:outline-none" placeholder="Search the docs" aria-label="Search the docs" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" data-search-input>
			<button type="button" class="rounded border border-line bg-raised px-1.5 text-[11px] leading-5 text-muted transition-colors hover:text-fg" data-search-close>Esc</button>
		</div>
		<div class="search-body">
			<p class="search-status" role="status" data-search-status>Search tags, filters, functions and guides.</p>
			<div id="search-results" role="listbox" aria-label="Results" data-search-results></div>
		</div>
		<div class="hidden items-center gap-4 border-t border-line px-4 py-2.5 text-[12px] text-muted sm:flex">
			<span><kbd class="search-key">↑</kbd> <kbd class="search-key">↓</kbd> to move</span>
			<span><kbd class="search-key">↵</kbd> to open</span>
			<span class="ml-auto">Search by <a href="https://pagefind.app" class="text-text hover:text-fg">Pagefind</a></span>
		</div>
	</div>
</dialog>
