{% props code, title = null %}

<figure class="code" data-code>
	{% if title %}
		<figcaption class="code-head"><span class="code-label">{{ title }}</span>{% include "components/copy" %}</figcaption>
	{% else %}
		{% include "components/copy" with { float: true } %}
	{% endif %}
	{{ code }}
</figure>
