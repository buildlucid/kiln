{% props previous, next %}

{% if previous or next %}
	<nav aria-label="Pages" class="mt-6 grid gap-3 border-t border-line pt-8 sm:grid-cols-2" data-pagefind-ignore>
		{% if previous %}
			<a href="{{ previous.url }}" class="group rounded-xl border border-line px-4 py-3.5 transition-colors hover:border-line-strong hover:bg-surface" rel="prev">
				<span class="flex items-center gap-1 text-[13px] text-muted">
					<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" class="transition-transform duration-200 group-hover:-translate-x-0.5"><path d="m10 4-4 4 4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
					Previous
				</span>
				<span class="mt-0.5 block font-medium text-fg">{{ previous.title }}</span>
			</a>
		{% endif %}
		{% if next %}
			<a href="{{ next.url }}" class="group rounded-xl border border-line px-4 py-3.5 text-right transition-colors hover:border-line-strong hover:bg-surface sm:col-start-2" rel="next">
				<span class="flex items-center justify-end gap-1 text-[13px] text-muted">
					Next
					<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5"><path d="m6 4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</span>
				<span class="mt-0.5 block font-medium text-fg">{{ next.title }}</span>
			</a>
		{% endif %}
	</nav>
{% endif %}
