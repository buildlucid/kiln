{% props label = "Copy code", text = null, float = false %}

{# Copies `text`, or the code in the closest `[data-code]`. See client/copy.ts. #}
<button type="button" class="copy js-only{{ float ? " copy-float" : "" }}" aria-label="{{ label }}" title="{{ label }}"{{ attrs({ "data-copy": text ?? true }) }}>
	<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" class="copy-idle"><rect x="5.25" y="5.25" width="8.5" height="8.5" rx="1.75" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.75 3.25v-.5a1.5 1.5 0 0 0-1.5-1.5h-6a1.5 1.5 0 0 0-1.5 1.5v6a1.5 1.5 0 0 0 1.5 1.5h.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
	<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" class="copy-done"><path d="m3.25 8.5 3 3 6.5-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
