{# Layout for every docs page. Pages fill the "content" block. #}
{% extends "layouts/base" %}

{% block main %}
<div class="mx-auto max-w-[88rem] px-4 sm:px-6 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12 xl:grid-cols-[15rem_minmax(0,1fr)_13rem]">
	<details class="group -mx-4 border-b border-line px-4 py-3 sm:-mx-6 sm:px-6 lg:hidden">
		<summary class="flex items-center justify-between text-sm text-fg">
			<span>{{ page.section ?? "Docs" }} <span class="text-muted">/</span> {{ page.title }}</span>
			<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" class="text-muted transition-transform group-open:rotate-180"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
		</summary>
		<div class="pt-5 pb-3">
			{% include "components/sidebar" with { current: page.url } %}
		</div>
	</details>

	<aside class="hidden lg:block">
		<div class="sticky top-14 max-h-[calc(100dvh-3.5rem)] overflow-y-auto py-10 pr-2">
			{% include "components/sidebar" with { current: page.url } %}
		</div>
	</aside>

	<main id="content" class="min-w-0 py-10 lg:py-14">
		<article class="mx-auto max-w-[44rem]">
			<header class="mb-10">
				{% if page.section is defined %}<p class="mb-3 text-sm font-medium text-ember">{{ page.section }}</p>{% endif %}
				<h1 class="text-[2rem] leading-tight font-semibold tracking-tight text-fg sm:text-[2.25rem]">{{ page.title }}</h1>
				<p class="mt-3 text-lg leading-relaxed text-muted">{{ page.description }}</p>
			</header>
			<div class="prose">
				{% block content %}{% endblock %}
			</div>
			{% include "components/pager" with { previous, next } %}
		</article>
	</main>

	<aside class="hidden xl:block">
		<div class="sticky top-14 py-14">
			<!-- toc -->
		</div>
	</aside>
</div>
{% endblock %}
