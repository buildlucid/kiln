{% extends "layouts/base" %}

{% block main %}
	<div class="mx-auto max-w-[88rem] px-4 sm:px-6 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12 xl:grid-cols-[15rem_minmax(0,1fr)_13rem]">
		<details class="mobile-nav group -mx-4 border-b border-line px-4 py-3 sm:-mx-6 sm:px-6 lg:hidden">
			<summary class="flex items-center justify-between text-sm text-fg">
				<span>{{ page.section ?? "Docs" }} <span class="text-muted">/</span> {{ page.title }}</span>
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" class="text-muted transition-transform group-open:rotate-180"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</summary>
			<div class="pt-5 pb-3">
				{% include "components/sidebar" with { current: page.url } %}
			</div>
		</details>

		<aside class="docs-sidebar hidden lg:block">
			<div class="sidebar-scroll sticky top-14 max-h-[calc(100dvh-3.5rem)] overflow-y-auto py-8 pr-2" data-sidebar-scroll>
				{% include "components/sidebar" with { current: page.url } %}
			</div>
			<script>
				(() => {
					const scroller = document.currentScript.previousElementSibling;
					const saved = sessionStorage.getItem("kiln:sidebar-scroll");
					if (saved !== null) scroller.scrollTop = Number(saved);
					const active = scroller.querySelector("[aria-current=page]");
					if (!active) return;
					const box = scroller.getBoundingClientRect();
					const item = active.getBoundingClientRect();
					if (item.top < box.top + 48 || item.bottom > box.bottom - 48)
						scroller.scrollTop += item.top - box.top - box.height / 3;
				})();
			</script>
		</aside>

		<main id="content" class="min-w-0 py-10 lg:py-14">
			<article class="mx-auto max-w-[44rem]" data-pagefind-body>
				<header class="mb-10">
					<div class="mb-3 flex min-h-7 items-center justify-between gap-4">
						{% if page.section is defined %}<p class="text-sm font-medium text-ember" data-pagefind-meta="section">{{ page.section }}</p>{% endif %}
						{% if markdown %}
							<button type="button" class="js-only ml-auto flex items-center gap-1.5 rounded-md border border-line px-2 py-1 text-[12px] text-muted transition-colors hover:border-line-strong hover:text-fg" data-copy-page="{{ markdown }}" data-pagefind-ignore>
								<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><rect x="5.25" y="5.25" width="8.5" height="8.5" rx="1.75" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.75 3.25v-.5a1.5 1.5 0 0 0-1.5-1.5h-6a1.5 1.5 0 0 0-1.5 1.5v6a1.5 1.5 0 0 0 1.5 1.5h.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
								<span data-copy-page-label>Copy as Markdown</span>
							</button>
						{% endif %}
					</div>
					<h1 class="text-[2rem] leading-tight font-semibold tracking-tight text-fg sm:text-[2.25rem]">{{ page.title }}</h1>
					<p class="mt-3 text-lg leading-relaxed text-muted">{{ page.description }}</p>
				</header>
				<div class="prose">
					{% block content %}{% endblock %}
				</div>
				<div class="mt-14 flex flex-wrap items-center justify-between gap-3 text-[13px] text-muted" data-pagefind-ignore>
					<a href="{{ site.source }}/{{ source }}" class="inline-flex items-center gap-1.5 transition-colors hover:text-fg">
						<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M9.5 3.5 12.5 6.5M2.75 13.25l.6-3.1 7.4-7.4a1.5 1.5 0 0 1 2.1 0l.4.4a1.5 1.5 0 0 1 0 2.1l-7.4 7.4-3.1.6Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
						Edit this page on GitHub
					</a>
					{% if markdown %}<a href="{{ markdown }}" class="transition-colors hover:text-fg">View as Markdown</a>{% endif %}
				</div>
				{% include "components/pager" with { previous, next } %}
			</article>
		</main>

		<aside class="hidden xl:block">
			<div class="docs-toc sticky top-14 py-14">
				<!-- toc -->
			</div>
		</aside>
	</div>
{% endblock %}
