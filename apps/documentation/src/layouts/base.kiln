{% props page, source = null, markdown = null, previous = null, next = null %}
{% set isHome = page.url == "/" %}
{% set isDoc = page.section is defined %}
{% set canonical = site.url ~ page.url %}

{% set website = { "@type": "WebSite", "@id": site.url ~ "/#website", url: site.url ~ "/", name: site.name, inLanguage: "en-GB" } %}
{% set software = {
	"@type": "SoftwareSourceCode",
	"@id": site.url ~ "/#software",
	name: site.name,
	description: page.description,
	url: site.url ~ "/",
	codeRepository: site.repository,
	programmingLanguage: ["TypeScript", "JavaScript"],
	runtimePlatform: ["Node.js", "Cloudflare Workers"],
	license: "https://opensource.org/licenses/MIT",
} %}

{% if isHome %}
	{% set graph = [website|merge({ description: page.description }), software] %}
{% elseif isDoc %}
	{% set graph = [
		website,
		{
			"@type": "TechArticle",
			headline: page.title,
			description: page.description,
			url: canonical,
			articleSection: page.section,
			inLanguage: "en-GB",
			isPartOf: { "@id": site.url ~ "/#website" },
			about: { "@id": site.url ~ "/#software" },
		},
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Docs", item: site.url ~ "/docs/" },
				{ "@type": "ListItem", position: 2, name: page.title, item: canonical },
			],
		},
	] %}
{% else %}
	{% set graph = [website] %}
{% endif %}

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% block title %}{{ page.title }}{% if isDoc %} · {{ page.section }}{% endif %} · {{ site.name }}{% endblock %}</title>
		<meta name="description" content="{{ page.description }}">
		{% if page.url == "/404.html" %}
			<meta name="robots" content="noindex">
		{% else %}
			<link rel="canonical" href="{{ canonical }}">
		{% endif %}
		<meta name="color-scheme" content="dark">
		<meta name="theme-color" content="#09090b">

		<meta property="og:type" content="{{ isDoc ? "article" : "website" }}">
		<meta property="og:site_name" content="{{ site.name }}">
		<meta property="og:locale" content="en_GB">
		<meta property="og:url" content="{{ canonical }}">
		<meta property="og:title" content="{{ block("title") }}">
		<meta property="og:description" content="{{ page.description }}">
		<meta property="og:image" content="{{ site.url }}/og.png">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta property="og:image:alt" content="{{ site.name }}: {{ site.tagline }}">
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content="{{ block("title") }}">
		<meta name="twitter:description" content="{{ page.description }}">
		<meta name="twitter:image" content="{{ site.url }}/og.png">

		<link rel="icon" href="/favicon.svg" type="image/svg+xml">
		<link rel="apple-touch-icon" href="/apple-touch-icon.png">
		<link rel="sitemap" href="/sitemap.xml" type="application/xml">
		{% if markdown %}<link rel="alternate" type="text/markdown" href="{{ markdown }}" title="{{ page.title }} as Markdown">{% endif %}
		<script type="application/ld+json">{{ { "@context": "https://schema.org", "@graph": graph }|json|raw }}</script>

		<script>document.documentElement.classList.add("js")</script>
		<link rel="stylesheet" href="/src/styles.css">
		<script type="module" src="/src/client/main.ts"></script>
	</head>
	<body class="min-h-dvh bg-bg">
		<a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-fg focus:px-3 focus:py-2 focus:text-sm focus:text-bg">Skip to content</a>
		{% include "components/header" with { current: page.url } %}
		{% block main %}{% endblock %}
		{% include "components/footer" %}
	</body>
</html>
